---
interface Props { title?: string }
const { title } = Astro.props;
const site = 'HSBlog';
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} — ${site}` : site}</title>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root { color-scheme: light; }
  * { box-sizing: border-box; }
  body {
    margin: 0; background: #fff; color: #000;
    font-family: -apple-system, "Apple SD Gothic Neo", Pretendard, sans-serif;
    font-size: 17px; line-height: 1.75; word-break: keep-all;
  }
  main { max-width: 680px; margin: 0 auto; padding: 72px 20px 96px; }
  a { color: inherit; }
  .site { display: inline-block; font-weight: 800; font-size: 18px; text-decoration: none; margin-bottom: 48px; }

  .list { list-style: none; margin: 0; padding: 0; border-top: 1px solid #000; }
  .list li { border-bottom: 1px solid #000; }
  .list a { display: flex; justify-content: space-between; gap: 16px; padding: 12px 0; text-decoration: none; }
  .list a:hover .t { text-decoration: underline; }
  .list .d { font-size: 14px; white-space: nowrap; font-variant-numeric: tabular-nums; }

  .back { display: inline-block; font-size: 14px; text-decoration: none; margin-bottom: 40px; }
  .back:hover { text-decoration: underline; }
  h1.title { font-size: 30px; line-height: 1.3; margin: 0 0 6px; }
  .date { font-size: 14px; margin: 0 0 40px; font-variant-numeric: tabular-nums; }

  .body h2 { font-size: 22px; margin: 40px 0 12px; }
  .body h3 { font-size: 18px; margin: 32px 0 8px; }
  .body img { max-width: 100%; height: auto; }
  .body blockquote { margin: 20px 0; padding-left: 16px; border-left: 3px solid #000; }
  .body code { font-family: ui-monospace, Menlo, monospace; font-size: 0.9em; }
  .body pre { border: 1px solid #000; padding: 14px 16px; overflow-x: auto; font-size: 14px; line-height: 1.6; background: #fff !important; }
  .body pre code { font-size: inherit; }
  .body hr { border: 0; border-top: 1px solid #000; margin: 40px 0; }
  .body table { border-collapse: collapse; }
  .body th, .body td { border: 1px solid #000; padding: 6px 10px; }

  @media (max-width: 560px) {
    body { font-size: 16px; }
    main { padding: 40px 18px 72px; }
    .site { margin-bottom: 32px; }
    .list a { flex-direction: column; gap: 0; }
    h1.title { font-size: 24px; }
  }
</style>
